# Force LF line endings regardless of core.autocrlf, so shell scripts and
# other LF-sensitive files don't silently break on checkout.
* text=auto eol=lf

*.sh text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.java text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.sql text eol=lf
