# Flipo local environment — copy to .env and adjust as needed.
# .env is gitignored; never commit real credentials.

# Postgres (docker-compose + backend/src/main/resources/application.properties
# share these names, so overriding here changes both consistently).
DB_USER=flipo
DB_PASSWORD=flipo_dev_password
DB_NAME=flipo
DB_HOST=localhost
DB_PORT=5432
